@using B2bOrder.Models.Common
@model ExpireNoticePageViewModel

@{
    ViewData["Title"] = "到期通知";
    var currentTab = ViewBag.Tab?.ToString() ?? "member";


    var keyword = ViewBag.Keyword as string ?? "";
    var status = ViewBag.Status as string ?? "";
    int page =
        Convert.ToInt32(ViewBag.Page);

    int total =
        Convert.ToInt32(ViewBag.Total);

    int pageSize =
        Convert.ToInt32(ViewBag.PageSize);

    int totalPages =
        (int)Math.Ceiling(
            total / (double)pageSize
        );

    // 計算目前的起始編號基礎值
    int startNumber = (page - 1) * pageSize;
    int index = 1;

    string nextDir(string field)
    {
        return ViewBag.SortField == field &&
               ViewBag.SortDir == "asc"
               ? "desc"
               : "asc";
    }


    var holder_str = "搜尋會員編號、姓名、Email";
    var cur_tab = "member";
    if (currentTab == "member")
    {
        cur_tab = "member";
    }
    else
    {
        cur_tab = "history";
        holder_str = "搜尋會員編號、通知類型、發送方式、標題";
    }
}

<div class="mb-4">

    <h1 class="fw-bold mb-2">
        @ViewData["Title"]
    </h1>

    <div class="text-muted">
        管理會員到期提醒與通知設定，並檢視發送紀錄
    </div>

</div>

<!-- 統計卡片 -->

<div class="row g-3 mb-4">

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-exclamation-circle-fill text-warning fs-1"></i>

                <h3 class="mt-2">
                    @Model.ExpireSoonCount
                </h3>

                <div class="text-muted">
                    即將到期會員
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-clock-history text-danger fs-1"></i>

                <h3 class="mt-2">
                    @Model.ExpiredCount
                </h3>

                <div class="text-muted">
                    已逾期會員
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-send-fill text-success fs-1"></i>

                <h3 class="mt-2">
                    @Model.NotifyCount
                </h3>

                <div class="text-muted">
                    本月通知數
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-check-circle-fill text-primary fs-1"></i>

                <h3 class="mt-2">
                    @Model.SuccessRate %
                </h3>

                <div class="text-muted">
                    成功率
                </div>

            </div>

        </div>

    </div>

</div>

<ul class="nav nav-tabs mb-4">

    <li class="nav-item">

        <a class="nav-link @(currentTab == "member" ? "active" : "")"
           asp-action="ExpireNotice"
           asp-route-tab="member">

            到期會員清單

        </a>

    </li>

    <li class="nav-item">

        <a class="nav-link @(currentTab == "history" ? "active" : "")"
           asp-action="ExpireNotice"
           asp-route-tab="history">

            通知紀錄

        </a>

    </li>

</ul>

<form method="get" class="mb-3">

    <input type="hidden"
           name="tab"
           value="@cur_tab" />

    <div class="row g-2">

        <div class="col-md-4">

            <input type="text"
                   name="keyword"
                   value="@ViewBag.Keyword"
                   class="form-control"
                   placeholder="@holder_str" />

        </div>

        <div class="col-md-1">

            <button class="btn btn-primary">

                <i class="bi bi-search"></i>
                搜尋

            </button>

        </div>

        <div class="col-md-2">

            @if (currentTab == "member")
            {
                <a asp-action="ExportExpireNotice"
                   asp-route-type="excel"
                   asp-route-keyword="@keyword"
                   class="btn btn-outline-primary">

                    <i class="bi bi-upload"></i>
                    匯出清單

                </a>
            }
            else
            {
                <a asp-action="ExportExpireHistory"
                   asp-route-type="excel"
                   asp-route-keyword="@keyword"
                   class="btn btn-outline-primary">

                    <i class="bi bi-upload"></i>
                    匯出紀錄

                </a>
            }

        </div>

    </div>

</form>
@if (currentTab == "member")
{

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <button class="btn btn-success btn-sm"
                    onclick="batchLine()" hidden>

                <i class="bi bi-line"></i>

                批次LINE通知

            </button>

            <button class="btn btn-warning btn-sm"
                    onclick="batchFcm()">

                <i class="bi bi-bell-fill"></i>

                批次FCM通知

            </button>

            <button class="btn btn-primary btn-sm"
                    onclick="batchEmail()">

                <i class="bi bi-envelope-fill"></i>

                批次Email通知

            </button>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th width="40">

                            <input type="checkbox"
                                   id="chkAll" />

                        </th>

                        <th width="80">編號</th> @* <-- 在第二欄加入編號標頭 *@

                        <th>
                            <a asp-action="ExpireNotice"
                               asp-route-keyword="@keyword"
                               asp-route-status="@status"
                               asp-route-sortField="mid"
                               asp-route-sortDir="@nextDir("mid")"
                               class="text-decoration-none text-dark">

                                會員編號

                                @if (ViewBag.SortField == "mid")
                                {
                                    <i class="bi @(ViewBag.SortDir == "asc"
                                                                                                                ? "bi-sort-down"
                                                                                                                : "bi-sort-up")"></i>
                                                        }

                            </a>
                        </th>
                        <th>
                            <a asp-action="ExpireNotice"
                               asp-route-keyword="@keyword"
                               asp-route-status="@status"
                               asp-route-sortField="name"
                               asp-route-sortDir="@nextDir("name")"
                               class="text-decoration-none text-dark">

                                姓名

                                @if (ViewBag.SortField == "name")
                                {
                                    <i class="bi @(ViewBag.SortDir == "asc"
                                                                                                                ? "bi-sort-down"
                                                                                                                : "bi-sort-up")"></i>
                                                        }

                            </a>
                        </th>
                        <th>
                            <a asp-action="ExpireNotice"
                               asp-route-keyword="@keyword"
                               asp-route-status="@status"
                               asp-route-sortField="role"
                               asp-route-sortDir="@nextDir("role")"
                               class="text-decoration-none text-dark">

                                角色

                                @if (ViewBag.SortField == "role")
                                {
                                    <i class="bi @(ViewBag.SortDir == "asc"
                                                                                                                ? "bi-sort-down"
                                                                                                                : "bi-sort-up")"></i>
                                                        }

                            </a>
                        </th>
                        <th>
