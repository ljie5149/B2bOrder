        <div class="table-responsive">

            <table class="table table-hover">

                <thead class="table-light">

                    <tr>

                        <th width="80">編號</th> @* <-- 在第二欄加入編號標頭 *@

                        <th>
                            <a asp-action="ExpireNotice"
                               asp-route-tab="@currentTab"
                               asp-route-keyword="@keyword"
                               asp-route-status="@status"
                               asp-route-sortField="SendDate"
