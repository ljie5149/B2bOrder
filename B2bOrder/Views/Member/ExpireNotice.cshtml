                                Email

                                @if (ViewBag.SortField == "Email")
                                {
                                    <i class="bi @(ViewBag.SortDir == "asc"
                                                                                                                ? "bi-sort-down"
                                                                                                                : "bi-sort-up")"></i>
                                                        }

                            </a>
                        </th>
                        <th>
                            <a asp-action="ExpireNotice"
                               asp-route-keyword="@keyword"
                               asp-route-status="@status"
                               asp-route-sortField="continueDate"
                               asp-route-sortDir="@nextDir("continueDate")"
                               class="text-decoration-none text-dark">

                                到期日

                                @if (ViewBag.SortField == "continueDate")
                                {
                                    <i class="bi @(ViewBag.SortDir == "asc"
                                                                                                                ? "bi-sort-numeric-down"
                                                                                                                : "bi-sort-numeric-up")"></i>
                                                        }

                            </a>
                        </th>
                        <th>
                            <a asp-action="ExpireNotice"
                               asp-route-keyword="@keyword"
                               asp-route-status="@status"
                               asp-route-sortField="avalible"
                               asp-route-sortDir="@nextDir("avalible")"
                               class="text-decoration-none text-dark">

                                狀態

                                @if (ViewBag.SortField == "avalible")
                                {
                                    <i class="bi @(ViewBag.SortDir == "asc"
                                                                                                                ? "bi-sort-down"
                                                                                                                : "bi-sort-up")"></i>
                                                        }

                            </a>
                        </th>

                        <th>
                            <!-- 新增上線名稱/編號欄位 -->
                            上線
                        </th>

                        <th>提醒天數</th>
                        <th>上次通知</th>
                        <th>操作</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Members)
                    {
                        // 計算當前這一筆的正確編號
                        int currentNo = startNumber + index;

                        <tr>

                            <td>

                                <input type="checkbox"
                                       class="chk-member"
                                       value="@item.Sid" />

                            </td>

                            <td>@currentNo</td>

                            <td>@item.Mid</td>

                            <td>@item.Name</td>

                            <td>@item.Role</td>

                            <td>@item.Mobile</td>

                            <td>@item.Email</td>

                            <td>

                                @item.ContinueDate?.ToString("yyyy-MM-dd")

                            </td>

                            <td>

                                @if (item.Status == "已逾期")
                                {
                                    <span class="badge bg-danger">
                                        已逾期
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        即將到期
                                    </span>
                                }

                            </td>

                            <!-- 顯示上線姓名與編號/帳號 -->
                            <td>
                                @if (!string.IsNullOrEmpty(item.ParentMid))
                                {
                                    <span>@item.ParentName (@item.ParentMid)</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td>

                                @item.HintDays 天

                            </td>

                            <td>

                                @(item.LastNotifyDate?.ToString("yyyy-MM-dd HH:mm")
                                                        ?? "尚未通知")

                            </td>

                            <td>

                                <button type="button"
                                        title="LINE通知"
                                        class="btn btn-success btn-sm"
                                        onclick="sendLine('@item.Sid')" hidden>

                                    <i class="bi bi-line"></i>
                                    LINE

                                </button>

                                @if (!string.IsNullOrWhiteSpace(item.FcmToken))
                                {
                                    <button type="button"
                                            title="FCM通知"
                                            class="btn btn-warning btn-sm"
                                            onclick="sendFcm('@item.Sid')">

                                        <i class="bi bi-bell-fill"></i>
                                        FCM

                                    </button>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Email))
                                {
                                    <button type="button"
                                            title="Email通知"
                                            class="btn btn-primary btn-sm"
                                            onclick="sendEmail('@item.Sid')">

                                        <i class="bi bi-envelope-fill"></i>
                                        Email

                                    </button>
                                }

                            </td>

                        </tr>
                        
                        index++; // 累加索引
                    }

                </tbody>

            </table>

        </div>

        <!-- 分頁 -->
        <div class="card-footer bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    顯示第
                    @((page - 1) * pageSize + 1)
                    ~
                    @(Math.Min(page * pageSize, total))
                    筆，共
                    @total
                    筆
                </div>

                <nav>
                    <ul class="pagination mb-0">

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">

                                <a class="page-link"
                                   asp-action="ExpireNotice"
                                   asp-route-page="@i"
                                   asp-route-tab="@currentTab"
                                   asp-route-keyword="@keyword"
                                   asp-route-status="@status"
                                   asp-route-sortField="@ViewBag.SortField"
                                   asp-route-sortDir="@ViewBag.SortDir">

                                    @i

                                </a>

                            </li>
                        }

                    </ul>
                </nav>

            </div>

        </div>
    </div>

}
else
{

