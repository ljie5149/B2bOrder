@section Scripts
{

    <script>

        document.getElementById("chkAll")
        ?.addEventListener("change", function () {

            document
                .querySelectorAll(".chk-member")
                .forEach(x => x.checked = this.checked);

        });

        function getSelectedMembers()
        {
            return [...document.querySelectorAll(".chk-member:checked")]
                .map(x => x.value);
        }

        async function sendLine(sid)
        {
            if (!confirm("確定發送 LINE 到期通知？"))
                return;

            const response =
                await fetch(
                    '/Member/SendLineNotice',
                    {
                        method: 'POST',
                        headers:
                        {
                            'Content-Type':
                                'application/x-www-form-urlencoded'
                        },
                        body: 'sid=' + sid
                    });

            const result =
                await response.json();

            if (result.success)
            {
                alert('LINE通知發送成功');
                location.reload();
            }
            else
            {
                alert(result.message);
            }
        }

        async function sendFcm(sid)
        {
            if (!confirm("確定發送 FCM 到期通知？"))
                return;

            const response =
                await fetch(
                    '/Member/SendFcmNotice',
                    {
                        method: 'POST',
                        headers:
                        {
                            'Content-Type':
                                'application/x-www-form-urlencoded'
                        },
                        body: 'sid=' + sid
                    });

            const result =
                await response.json();

            if (result.success)
            {
                alert('FCM通知發送成功');
                location.reload();
            }
            else
            {
                alert(result.message);
            }
        }

        async function sendEmail(sid)
        {
            if (!confirm("確定發送 Email 到期通知？"))
                return;

            const response =
                await fetch(
                    '/Member/SendEmailNotice',
                    {
                        method: 'POST',
                        headers:
                        {
                            'Content-Type':
                                'application/x-www-form-urlencoded'
                        },
                        body: 'sid=' + sid
                    });

            const result =
                await response.json();

            if (result.success)
            {
                alert('Email通知發送成功');
                location.reload();
            }
            else
            {
                alert(result.message);
            }
        }

        async function batchLine()
        {
            const ids =
                getSelectedMembers();

            if (ids.length === 0)
            {
                alert("請先勾選會員");
                return;
            }

            if (!confirm(`確定發送 ${ids.length} 位會員 LINE 通知？`))
                return;

            const response =
                await fetch(
                    '/Member/BatchLineNotice',
                    {
                        method: 'POST',
                        headers:
                        {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(ids)
                    });

            const result =
                await response.json();

            if (result.success)
            {
                alert(`成功發送 ${result.count} 筆 LINE 通知`);
                location.reload();
            }
            else
            {
                alert(`發送 LINE 通知結果 :\n發送成功 :${result.count} 筆\n發送失敗 :${result.error_count} 筆`);
                location.reload();
            }
        }

        async function batchFcm()
        {
            const ids =
                getSelectedMembers();

            if (ids.length === 0)
            {
                alert("請先勾選會員");
                return;
            }

            if (!confirm(`確定發送 ${ids.length} 位會員 FCM 通知？`))
                return;

            const response =
                await fetch(
                    '/Member/BatchFcmNotice',
                    {
                        method: 'POST',
                        headers:
                        {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(ids)
                    });

            const result =
                await response.json();

            if (result.success)
            {
                alert(`成功發送 ${result.count} 筆 FCM 通知`);
                location.reload();
            }
            else
            {
                alert(`發送 FCM 通知結果 :\n發送成功 :${result.count} 筆\n發送失敗 :${result.error_count} 筆`);
                location.reload();
            }
        }

        async function batchEmail()
        {
            const ids =
                getSelectedMembers();

            if (ids.length === 0)
            {
                alert("請先勾選會員");
                return;
            }

            if (!confirm(`確定發送 ${ids.length} 位會員 Email 通知？`))
                return;

            const response =
                await fetch(
                    '/Member/BatchEmailNotice',
                    {
                        method: 'POST',
                        headers:
                        {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(ids)
                    });

            const result =
                await response.json();

            if (result.success)
            {
                alert(`成功發送 ${result.count} 筆 Email 通知`);
                location.reload();
            }
            else
            {
                alert(`發送 Email 通知結果 :\n發送成功 :${result.count} 筆\n發送失敗 :${result.error_count} 筆`);
                location.reload();
            }
        }

    </script>

}


