@using B2bOrder.Models.Common
@model B2bOrder.Models.RegisterViewModel

@{
    ViewData["Title"] = "會員註冊";
}

<div class="register-wrapper">
    <div class="register-container">

        <partial name="_Brand" />

        <div class="card register-card border-0 shadow">
            <div class="row g-0">

                <div class="col-lg-4 register-left-panel d-none d-lg-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="panel-icon-badge">
                                <i class="bi bi-person-plus-fill text-primary"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold text-dark mb-1">加入成為會員</h4>
                                <small class="text-muted">請填寫以下資料完成註冊</small>
                            </div>
                        </div>
                        <hr class="text-muted opacity-25 my-4">

                        <div class="feature-list d-flex flex-column gap-4">
                            <div class="feature-item d-flex align-items-start gap-3">
                                <div class="feature-icon"><i class="bi bi-shield-check text-primary"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-1">安全可靠</h6>
                                    <p class="text-muted small mb-0">我們嚴格保護您的個人資料安全</p>
                                </div>
                            </div>
                            <div class="feature-item d-flex align-items-start gap-3">
                                <div class="feature-icon"><i class="bi bi-people text-primary"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-1">專屬服務</h6>
                                    <p class="text-muted small mb-0">加入會員即可享有專屬功能與服務</p>
                                </div>
                            </div>
                            <div class="feature-item d-flex align-items-start gap-3">
                                <div class="feature-icon"><i class="bi bi-bell text-primary"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-1">即時通知</h6>
                                    <p class="text-muted small mb-0">重要通知與到期提醒不漏接</p>
                                </div>
                            </div>
                            <div class="feature-item d-flex align-items-start gap-3">
                                <div class="feature-icon"><i class="bi bi-bar-chart text-primary"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-1">組織管理</h6>
                                    <p class="text-muted small mb-0">輕鬆管理您的團隊與會員資料</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="login-redirect-box p-3 rounded">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-question-circle text-primary fs-5"></i>
                            <div>
                                <span class="small text-dark fw-medium">已有帳號？</span><br>
                                <a asp-controller="Member" asp-action="Login" class="small text-primary fw-bold text-decoration-none">立即登入系統</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8 p-4 p-sm-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success" role="alert">@TempData["Success"]</div>
                    }

                    <form asp-action="Register" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <!-- 會員編號 + 會員姓名 同一列 -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Mid" class="form-label fw-medium">會員編號 <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="Mid" class="form-control border-start-0 ps-0 @(ViewData.ModelState["Mid"]?.Errors.Count > 0 ? "is-invalid" : "")" placeholder="請輸入會員編號" />
                                </div>
                                <span asp-validation-for="Mid" class="invalid-feedback"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-medium">姓名 <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="Name" class="form-control border-start-0 ps-0 @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "is-invalid" : "")" placeholder="請輸入姓名" />
                                </div>
                                <span asp-validation-for="Name" class="invalid-feedback"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Role" class="form-label fw-medium">
                                    會員角色 <span class="text-danger">*</span>
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted">
                                        <i class="bi bi-person-badge"></i>
                                    </span>

                                    <select asp-for="Role" class="form-select">
                                        @foreach (var role in MemberRoles.RegisterRoles)
                                        {
                                            <option value="@role">
                                                @MemberRoles.GetName(role)
                                            </option>
                                        }
                                    </select>
                                </div>

                                <span asp-validation-for="Role" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Mobile" class="form-label fw-medium">手機 <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-phone"></i></span>
                                    <input asp-for="Mobile" class="form-control border-start-0 ps-0 @(ViewData.ModelState["Mobile"]?.Errors.Count > 0 ? "is-invalid" : "")" placeholder="請輸入手機號碼" />
                                </div>
                                <div class="small text-muted mt-1">將用於重要通知與驗證</div>
                                <span asp-validation-for="Mobile" class="invalid-feedback"></span>
                            </div>

                            <!-- 加入日期 + 續約日期 同一列 -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="JoinDate" class="form-label fw-medium">加入日期 <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-calendar"></i></span>
                                    <input asp-for="JoinDate" class="form-control border-start-0 ps-0" type="date" />
                                </div>
                                <span asp-validation-for="JoinDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ContinueDate" class="form-label fw-medium">續約日期</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-calendar2-check"></i></span>
                                    <input asp-for="ContinueDate" id="RegisterContinueDate" class="form-control border-start-0 ps-0" type="date" />
                                    <button id="markRenewedBtnRegister" type="button" class="btn btn-success" title="以今天標記已續約" aria-label="已續約">已續約</button>
                                </div>
                                <span asp-validation-for="ContinueDate" class="text-danger"></span>
                            </div>

                            <!-- 密碼 + 確認密碼 同一列 -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-medium">密碼 <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" type="password" class="form-control border-start-0 border-end-0 ps-0 @(ViewData.ModelState["Pwd"]?.Errors.Count > 0 ? "is-invalid" : "")" id="registerPwd" placeholder="請輸入密碼" />
                                    <button class="btn btn-outline-light border border-start-0 text-muted bg-white" type="button" id="toggleRegisterPwd">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="invalid-feedback"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-medium">確認密碼 <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 border-end-0 ps-0 @(ViewData.ModelState["ConfirmPwd"]?.Errors.Count > 0 ? "is-invalid" : "")" id="confirmPwd" placeholder="請再次輸入密碼" />
                                    <button class="btn btn-outline-light border border-start-0 text-muted bg-white" type="button" id="toggleConfirmPwd">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="invalid-feedback"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-medium">電子信箱 <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" type="email" class="form-control border-start-0 ps-0 @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")" placeholder="請輸入電子信箱" />
                                </div>
                                <span asp-validation-for="Email" class="invalid-feedback"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-medium">身分證字號</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-card-text"></i></span>
                                    <input type="text" name="IdNumber" class="form-control border-start-0 ps-0" placeholder="請輸入身分證字號" />
                                </div>
                            </div>

                            <div class="col-12 mb-4">
                                <label asp-for="ParentMid" class="form-label fw-medium">推薦人會員編號(上線)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="ParentMid" class="form-control border-start-0 ps-0 @(ViewData.ModelState["ParentMid"]?.Errors.Count > 0 ? "is-invalid" : "")" placeholder="請輸入推薦人會員編號(非必填)" />
                                </div>
                                <span asp-validation-for="ParentMid" class="invalid-feedback"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="AgreeTerms"
                                           class="form-check-input @(ViewData.ModelState["AgreeTerms"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                           id="agreeTerms" />

                                    <label asp-for="AgreeTerms"
                                           class="form-check-label fw-medium"
                                           for="agreeTerms">
                                        我已閱讀並同意
                                        <a href="#" class="text-primary text-decoration-none">隱私權政策</a>
                                        及
                                        <a href="#" class="text-primary text-decoration-none">使用條款</a>
                                    </label>
                                </div>

                                <div class="invalid-feedback d-block">
                                    <span asp-validation-for="AgreeTerms"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-sm-8">
                                <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2" style="background-color: #1e60eb; border-color: #1e60eb;">
                                    <i class="bi bi-person-plus"></i> 註冊會員
                                </button>
                            </div>
                            <div class="col-sm-4">
                                <button type="reset" class="btn btn-outline-secondary w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2 bg-white text-muted border-secondary-subtle">
                                    <i class="bi bi-arrow-counterclockwise"></i> 清除重填
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // 共用密碼顯示/隱藏切換
            function setupPasswordToggle(btnId, inputId) {
                const toggleBtn = document.getElementById(btnId);
                const pwdInput = document.getElementById(inputId);
                if (toggleBtn && pwdInput) {
                    toggleBtn.addEventListener('click', function () {
                        const isPwd = pwdInput.type === 'password';
                        pwdInput.type = isPwd ? 'text' : 'password';
                        this.querySelector('i')?.classList.toggle('bi-eye-slash');
                        this.querySelector('i')?.classList.toggle('bi-eye');
                    });
                }
            }

            setupPasswordToggle('toggleRegisterPwd', 'registerPwd');
            setupPasswordToggle('toggleConfirmPwd', 'confirmPwd');

            // Bootstrap Client-side 驗證流程（保留，不影響 unobtrusive）
            const forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();

        // jQuery Validate: 忽略隱藏欄位（保留你原本的設定）
        $("form").validate({
          ignore: ":hidden"
        });

        // 註冊頁：「已續約」按鈕（綠底白字），填入今天日期到續約欄位（yyyy-MM-dd）
        (function () {
            function pad(n) { return n < 10 ? '0' + n : n; }
            function toLocalDateString(d) {
                return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
            }

            const renewBtn = document.getElementById('markRenewedBtnRegister');
            const continueInput = document.getElementById('RegisterContinueDate');
            if (renewBtn && continueInput) {
                renewBtn.addEventListener('click', function () {
                    const today = new Date();
                    continueInput.value = toLocalDateString(today);
                    continueInput.dispatchEvent(new Event('input', { bubbles: true }));
                    continueInput.focus();
                });
            }
        })();
    </script>
}