@{
    ViewData["Title"] = "密碼重設成功";
}

<div class="register-wrapper">
    <div class="register-container">

        <partial name="_Brand" />

        <div class="card register-card border-0 shadow mx-auto" style="max-width: 500px;">
            <div class="card-body p-4 p-sm-5 text-center">

                <div class="panel-icon-badge mx-auto mb-4" style="width: 80px; height: 80px; background-color: #e6f7ed; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                </div>

                <h3 class="fw-bold text-dark mb-3">@ViewData["Title"]！</h3>

                <p class="text-muted mb-4 px-2">
                    您的新密碼已啟用。為了確保您的帳號安全，舊密碼已失效，請使用剛才設定的新密碼重新登入系統。
                </p>

                <div class="card bg-light border-0 p-3 rounded mb-4 text-start">
                    <div class="d-flex align-items-center gap-2 text-muted small">
                        <i class="bi bi-shield-fill-check text-primary"></i>
                        <span class="text-dark fw-medium">安全提示：請勿將新密碼透露給任何人。</span>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Member" asp-action="Login" class="btn btn-primary py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2" style="background-color: #1e60eb; border-color: #1e60eb;">
                        <i class="bi bi-box-arrow-in-right"></i> 立即登入系統
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>