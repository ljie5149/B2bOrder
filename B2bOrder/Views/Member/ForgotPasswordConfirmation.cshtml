@model B2bOrder.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "已發送重設密碼連結";
}

<div class="register-wrapper">
    <div class="register-container">

        <partial name="_Brand" />

        <div class="card register-card border-0 shadow mx-auto" style="max-width: 550px;">
            <div class="card-body p-4 p-sm-5 text-center">

                <div class="panel-icon-badge mx-auto mb-4" style="width: 80px; height: 80px; background-color: #e8f0fe; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-envelope-check-fill text-primary" style="font-size: 2.5rem;"></i>
                </div>

                <h3 class="fw-bold text-dark mb-3">請檢查您的電子信箱</h3>

                <p class="text-muted mb-4 px-2">
                    我們已經將重設密碼的連結發送到您的註冊信箱。<br>
                    請點擊郵件中的連結以重新設定您的密碼。
                </p>

                <div class="card bg-light border-0 p-3 rounded mb-4 text-start">
                    <div class="d-flex align-items-start gap-2 text-muted small">
                        <i class="bi bi-exclamation-circle-fill text-primary mt-0.5"></i>
                        <div>
                            <span class="fw-bold text-dark d-block mb-1">沒收到郵件嗎？</span>
                            <ul class="ps-3 mb-0" style="list-style-type: disc;">
                                <li class="mb-1">請檢查「垃圾郵件」或「促銷內容」分頁。</li>
                                <li>重設連結將在 <strong>30 分鐘</strong> 後失效。</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Member" asp-action="Login" class="btn btn-primary py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2" style="background-color: #1e60eb; border-color: #1e60eb;">
                        <i class="bi bi-box-arrow-in-right"></i> 返回登入頁面
                    </a>

                    <form asp-action="ForgotPassword" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AccountValue" value="@TempData["AccountValue"]" />
                        <button type="submit" id="btnResend" class="btn btn-link text-primary text-decoration-none small fw-medium">
                            沒收到？重新發送驗證信
                        </button>
                    </form>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // 防止使用者連續惡意點擊重新發送，做一個簡單的倒數鎖定
        (function () {
            const btnResend = document.getElementById('btnResend');
            if (!btnResend) return;

            const COOLDOWN_KEY = 'resend_cooldown_timestamp';
            const COOLDOWN_SECONDS = 60; // 設定倒數秒數

            // 啟動倒數計時器
            function startTimer(remainingSeconds) {
                btnResend.disabled = true;
                btnResend.classList.remove('text-primary');
                btnResend.classList.add('text-muted');
                btnResend.textContent = `重新發送驗證信 (${remainingSeconds}秒)`;

                const timer = setInterval(function () {
                    remainingSeconds--;
                    if (remainingSeconds > 0) {
                        btnResend.textContent = `重新發送驗證信 (${remainingSeconds}秒)`;
                    } else {
                        clearInterval(timer);
                        localStorage.removeItem(COOLDOWN_KEY);
                        btnResend.disabled = false;
                        btnResend.textContent = '沒收到？重新發送驗證信';
                        btnResend.classList.remove('text-muted');
                        btnResend.classList.add('text-primary');
                    }
                }, 1000);
            }

            // 1. 【頁面載入時】檢查是否有未結束的倒數
            const lastTime = localStorage.getItem(COOLDOWN_KEY);
            if (lastTime) {
                const passedSeconds = Math.floor((Date.now() - parseInt(lastTime, 10)) / 1000);
                if (passedSeconds < COOLDOWN_SECONDS) {
                    // 還在冷卻時間內，直接啟動剩餘秒數倒數
                    startTimer(COOLDOWN_SECONDS - passedSeconds);
                } else {
                    // 已經超過冷卻時間，清除舊資料
                    localStorage.removeItem(COOLDOWN_KEY);
                }
            }

            // 2. 【表單送出時】寫入目前時間戳記
            const form = btnResend.closest('form');
            if (form) {
                form.addEventListener('submit', function () {
                    localStorage.setItem(COOLDOWN_KEY, Date.now().toString());
                });
            }
        })();
    </script>
}