@model B2bOrder.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "忘記密碼";
}

<div class="register-wrapper">
    <div class="register-container">

        <partial name="_Brand" />

        <div class="card register-card border-0 shadow">
            <div class="row g-0">

                <div class="col-lg-4 register-left-panel d-none d-lg-flex flex-column justify-content-between p-4 text-center">
                    <div class="my-auto">
                        <div class="panel-icon-badge mx-auto mb-4" style="width: 60px; height: 60px; background-color: #e8f0fe; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-lock-fill text-primary fs-3"></i>
                        </div>

                        <h3 class="fw-bold text-dark mb-3">@ViewData["Title"]</h3>
                        <p class="text-muted small px-3">
                            請輸入您註冊時使用的會員編號或電子信箱，我們將寄送重設密碼的連結給您。
                        </p>

                        <div class="mt-4 mb-2">
                            <div class="position-relative d-inline-block">
                                <i class="bi bi-envelope-open text-primary opacity-75" style="font-size: 5rem;"></i>
                                <i class="bi bi-send-fill text-primary position-absolute pt-2" style="font-size: 1.5rem; top: 0; right: -20px; transform: rotate(15deg);"></i>
                            </div>
                        </div>
                    </div>

                    <div class="text-start mt-auto ps-2">
                        <a asp-controller="Member" asp-action="Login" class="small text-primary fw-medium text-decoration-none d-flex align-items-center gap-1">
                            <i class="bi bi-arrow-left"></i> 返回登入頁
                        </a>
                    </div>
                </div>

                <div class="col-lg-8 p-4 p-sm-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success" role="alert">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
                    }

                    <form asp-action="ForgotPassword" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">選擇驗證方式 <span class="text-danger">*</span></label>
                            <div class="d-flex gap-4 mt-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="AccountType" id="typeUsername" value="Username" checked>
                                    <label class="form-check-label fw-medium text-dark" for="typeUsername">
                                        使用會員編號
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="AccountType" id="typeEmail" value="Email">
                                    <label class="form-check-label fw-medium text-dark" for="typeEmail">
                                        使用電子信箱
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label id="inputLabel" class="form-label fw-medium">會員編號 <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted" id="inputIcon">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input id="accountInput" name="AccountValue" class="form-control border-start-0 ps-0" placeholder="請輸入您的會員編號" required />
                            </div>
                            <small id="inputHelp" class="text-muted d-block mt-1">請輸入您註冊時的會員編號以進行身分驗證</small>
                        </div>

                        <div class="mb-4">
                            <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2" style="background-color: #1e60eb; border-color: #1e60eb;">
                                <i class="bi bi-send"></i> 發送重設密碼連結
                            </button>
                        </div>

                        <div class="card bg-light border-0 p-3 rounded">
                            <div class="d-flex align-items-center gap-2 text-primary mb-2">
                                <i class="bi bi-info-circle-fill"></i>
                                <span class="fw-bold small">注意事項</span>
                            </div>
                            <ul class="text-muted small mb-0 ps-3" style="list-style-type: disc;">
                                <li class="mb-1">重設連結將有效 30 分鐘</li>
                                <li class="mb-1">請檢查您的電子信箱（包含垃圾郵件匣）</li>
                                <li>若未收到郵件，請稍後再試或聯繫系統管理員</li>
                            </ul>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const typeUsername = document.getElementById('typeUsername');
            const typeEmail = document.getElementById('typeEmail');
            const inputLabel = document.getElementById('inputLabel');
            const inputIcon = document.getElementById('inputIcon');
            const accountInput = document.getElementById('accountInput');
            const inputHelp = document.getElementById('inputHelp');

            // 切換驗證方式的 UI 顯示邏輯
            function toggleInputFields() {
                if (typeUsername.checked) {
                    inputLabel.innerHTML = '會員編號 <span class="text-danger">*</span>';
                    inputIcon.innerHTML = '<i class="bi bi-person"></i>';
                    accountInput.type = 'text';
                    accountInput.placeholder = '請輸入您的會員編號';
                    inputHelp.textContent = '請輸入您註冊時的會員編號以進行身分驗證';
                } else if (typeEmail.checked) {
                    inputLabel.innerHTML = '電子信箱 <span class="text-danger">*</span>';
                    inputIcon.innerHTML = '<i class="bi bi-envelope"></i>';
                    accountInput.type = 'email';
                    accountInput.placeholder = '請輸入您的電子信箱';
                    inputHelp.textContent = '請輸入您註冊時的電子信箱以進行身分驗證';
                }
            }

            if (typeUsername && typeEmail) {
                typeUsername.addEventListener('change', toggleInputFields);
                typeEmail.addEventListener('change', toggleInputFields);
                // 頁面載入時先執行一次，避免瀏覽器記住單選按鈕狀態導致 UI 不一致
                toggleInputFields();
            }

            // Bootstrap Client-side 驗證流程
            const forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}