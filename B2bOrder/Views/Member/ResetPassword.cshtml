@model B2bOrder.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "重設密碼";
}

<div class="register-wrapper">
    <div class="register-container">

        <partial name="_Brand" />

        <div class="card register-card border-0 shadow">
            <div class="row g-0">

                <div class="col-lg-4 register-left-panel d-none d-lg-flex flex-column justify-content-between p-4 text-center">
                    <div class="my-auto">
                        <div class="panel-icon-badge mx-auto mb-4" style="width: 60px; height: 60px; background-color: #e8f0fe; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-shield-lock-fill text-primary fs-3"></i>
                        </div>

                        <h3 class="fw-bold text-dark mb-3">設定新密碼</h3>
                        <p class="text-muted small px-3">
                            請為您的帳號設定一個全新的安全密碼。建議包含大小寫英文字母與數字。
                        </p>

                        <div class="mt-4 mb-2">
                            <div class="position-relative d-inline-block">
                                <i class="bi bi-shield-shaded text-primary opacity-75" style="font-size: 5rem;"></i>
                                <i class="bi bi-key-fill text-primary position-absolute" style="font-size: 2rem; bottom: 5px; right: -10px; transform: rotate(-45deg);"></i>
                            </div>
                        </div>
                    </div>

                    <div class="text-start mt-auto ps-2">
                        <a asp-controller="Member" asp-action="Login" class="small text-primary fw-medium text-decoration-none d-flex align-items-center gap-1">
                            <i class="bi bi-arrow-left"></i> 返回登入頁
                        </a>
                    </div>
                </div>

                <div class="col-lg-8 p-4 p-sm-5">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
                    }

                    <form asp-action="ResetPassword" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-medium">新密碼 <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" type="password" class="form-control border-start-0 border-end-0 ps-0" id="resetPwd" placeholder="請輸入新密碼" required />
                                <button class="btn btn-outline-light border border-start-0 text-muted bg-white" type="button" id="toggleResetPwd">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="invalid-feedback"><span asp-validation-for="Password"></span></div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-medium">確認新密碼 <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock-check"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 border-end-0 ps-0" id="confirmResetPwd" placeholder="請再次輸入新密碼" required />
                                <button class="btn btn-outline-light border border-start-0 text-muted bg-white" type="button" id="toggleConfirmResetPwd">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="invalid-feedback"><span asp-validation-for="ConfirmPassword"></span></div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2" style="background-color: #1e60eb; border-color: #1e60eb;">
                                    <i class="bi bi-check-circle"></i> 儲存新密碼並登入
                                </button>
                            </div>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // 密碼顯示/隱藏切換功能 (沿用註冊頁邏輯)
            function setupPasswordToggle(btnId, inputId) {
                const toggleBtn = document.getElementById(btnId);
                const pwdInput = document.getElementById(inputId);
                if (toggleBtn && pwdInput) {
                    toggleBtn.addEventListener('click', function () {
                        const isPwd = pwdInput.type === 'password';
                        pwdInput.type = isPwd ? 'text' : 'password';
                        this.querySelector('i')?.classList.toggle('bi-eye');
                        this.querySelector('i')?.classList.toggle('bi-eye-slash');
                    });
                }
            }

            setupPasswordToggle('toggleResetPwd', 'resetPwd');
            setupPasswordToggle('toggleConfirmResetPwd', 'confirmResetPwd');

            // Bootstrap 頁面客戶端驗證
            const forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}