@model B2bOrder.Models.LoginViewModel

@{
    ViewData["Title"] = "會員登入";
}

<div class="login-wrapper d-flex align-items-center justify-content-center">
    <div class="login-container">

        <partial name="_Brand" />

        <div class="card shadow auth-card border-0 animate__animated animate__fadeIn">
            <div class="card-body p-4 p-md-5">
                
                <div class="text-center mb-4">
                    <div class="login-icon-badge mb-2 mx-auto">
                        <i class="bi bi-lock text-primary"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-0">@ViewData["Title"]</h3>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Login" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Mid" class="form-label fw-medium text-secondary">會員編號</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="Mid" class="form-control border-start-0 ps-0" placeholder="請輸入會員編號" required />
                        </div>
                        <div class="invalid-feedback">請輸入您的會員編號。</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-medium text-secondary">密碼</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control border-start-0 border-end-0 ps-0" id="pwdInput" placeholder="請輸入密碼" required />
                            <button class="btn btn-outline-light border-start-0 border text-muted bg-white" type="button" id="togglePwd">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback">請輸入您的密碼。</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 small">
                        <a asp-controller="Member" asp-action="ForgotPassword" class="text-decoration-none text-primary d-flex align-items-center gap-1">
                            <i class="bi bi-question-circle"></i> 忘記密碼
                        </a>
                        <a asp-controller="Member" asp-action="Register" class="text-decoration-none text-primary d-flex align-items-center gap-1 fw-medium">
                            <i class="bi bi-person-plus"></i> 加入成為會員?
                        </a>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">記住我</label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-login py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-box-arrow-in-right fs-5"></i> 登入
                        </button>
                    </div>
                </form>
            </div>

            <div class="card-footer bg-light border-0 text-center text-muted small py-3">
                請使用公司提供的帳號密碼登入
            </div>
        </div>

        <div class="text-center mt-4 text-muted small">
            &copy; 2024 B2bOrder. All rights reserved.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';
            // 密碼眼睛切換
            const toggleBtn = document.getElementById('togglePwd');
            const pwdInput = document.getElementById('pwdInput');
            if (toggleBtn && pwdInput) {
                toggleBtn.addEventListener('click', function () {
                    const isPwd = pwdInput.type === 'password';
                    pwdInput.type = isPwd ? 'text' : 'password';
                    const icon = this.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('bi-eye-slash');
                        icon.classList.toggle('bi-eye');
                    }
                });
            }

            // Bootstrap 表單驗證
            const forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}