@model ExpireNoticePageViewModel

<div class="row g-3 mb-4">

    <div class="col-lg-3 col-md-6">

        <div class="card shadow-sm border-0">

            <div class="card-body text-center">

                <i class="bi bi-person-exclamation
                          text-warning fs-1"></i>

                <h3 class="mt-2">
                    @Model.ExpireSoonCount
                </h3>

                <div class="text-muted">
                    即將到期會員
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card shadow-sm border-0">

            <div class="card-body text-center">

                <i class="bi bi-clock-history
                          text-danger fs-1"></i>

                <h3 class="mt-2">
                    @Model.ExpiredCount
                </h3>

                <div class="text-muted">
                    已逾期會員
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card shadow-sm border-0">

            <div class="card-body text-center">

                <i class="bi bi-send-fill
                          text-success fs-1"></i>

                <h3 class="mt-2">
                    @Model.NotifyCount
                </h3>

                <div class="text-muted">
                    本月通知數
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card shadow-sm border-0">

            <div class="card-body text-center">

                <i class="bi bi-check-circle-fill
                          text-primary fs-1"></i>

                <h3 class="mt-2">
                    @Model.SuccessRate %
                </h3>

                <div class="text-muted">
                    成功率
                </div>

            </div>

        </div>

    </div>

</div>