@using B2bOrder.Models.Common
@using B2bOrder.Services
@inject IMemberService MemberService
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - B2bOrder</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "has-sidebar" : "no-sidebar")">
    @* 只有已登入時才顯示側邊選單與選單按鈕 *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        string displayItem4Admin  = "";
        string displayItem4Normal = "";
        <header class="topbar">
            <div class="topbar-left">
            </div>

            <div class="topbar-right">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-notifications">
                        <span class="bi bi-bell badge-notification"></span>
                    </div>

                    // 依 member_sid claim 讀取 data_member.name，若無則 fallback 顯示 identity name 或 account claim
                    // 不能在同步 block 使用 await，改為同步取得 service 結果
                    string displayName = "Admin";
                    string displayMid = "";
                    string displayRole = "";
                    string displayColor = "secondary";

                    var memberSid = User.FindFirst("member_sid")?.Value;

                    if (!string.IsNullOrEmpty(memberSid))
                    {
                        try
                        {
                            var dm = MemberService.GetBySidAsync(memberSid)
                            .GetAwaiter()
                            .GetResult();

                            if (dm != null)
                            {
                                displayName = dm.Name ?? "";
                                displayMid = dm.Mid ?? "";
                                displayRole = MemberRoles.GetName(dm.Role);
                                displayColor = MemberRoles.GetBadgeClass(dm.Role).Replace("bg-", "") ?? "secondary";
                                displayItem4Admin  = (dm.Role == MemberRoles.Admin) ? "" : "hidden";
                                displayItem4Normal = (dm.Role != MemberRoles.Admin) ? "" : "hidden";
                            }
                        }
                        catch
                        {
                        }
                    }

                    <div class="dropdown user-profile">
                        <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            
                            <div class="text-start">
                                <div class="fw-semibold">
                                    <i class="bi bi-person-circle me-1"></i>
                                    @displayName
                                </div>

                                <span class="badge bg-@displayColor fs-5 px-3 py-2">
                                    @displayMid
                                    <span class="badge bg-light text-dark ms-1">
                                        @displayRole
                                    </span>
                                </span>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li>
                                <a class="dropdown-item" asp-controller="Member" asp-action="Center">
                                    <i class="bi bi-gear me-2"></i> 個人資料管理
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                @* 改為觸發確認對話框，實際登出由隱藏表單提交 *@
                                <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#confirmLogoutModal">
                                    <i class="bi bi-box-arrow-right me-2"></i> 登出
                                </button>
                            </li>
                        </ul>
                    </div>

                    @* 隱藏的登出表單（包含防偽 token），由確認按鈕提交 *@
                    <form id="logoutForm" asp-controller="Member" asp-action="Logout" method="post" class="d-none">
                        @Html.AntiForgeryToken()
                    </form>
                }
                else
                {
                    <div class="auth-links">
                        <a asp-controller="Member" asp-action="Login" class="auth-link link-signin">登入</a>
                        <a asp-controller="Member" asp-action="Register" class="auth-link link-signup">註冊</a>
                    </div>
                }
            </div>
        </header>


        <button class="sidebar-menu-button">
            <span class="bi bi-list"></span>
        </button>

        <aside class="sidebar" data-key="sidebar">
            <header class="sidebar-header">
                <a asp-controller="Home" asp-action="Index" class="header-logo">
                    <img src="~/images/logo03-1.png"
                         alt="Logo"
                         style="width: 48px; height: 48px; display: block; object-fit: contain; border-radius: 50%;" />
                </a>
                <button class="sidebar-toggler">
                    <span class="bi bi-chevron-left"></span>
                </button>
            </header>

            <nav class="sidebar-nav">
                <ul class="nav-list primary-nav">


                    <!-- 首頁儀表板 -->
                    <li class="nav-item @(IsActive("Home", "Index") ? "active" : "")">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">
                            <span class="bi bi-speedometer2"></span>
                            <span class="nav-label">首頁儀表板</span>
                        </a>
                    </li>

                    <!-- 會員管理 -->
                    @{
                        // 檢查目前的 Controller 是否為 Member
                        bool isMemberController = ViewContext.RouteData.Values["Controller"]?.ToString() == "Member";
                    }
                    <li class="nav-item dropdown-container @(isMemberController ? "open" : "")" @displayItem4Normal>
                        <a href="#" class="nav-link dropdown-toggle">
                            <span class="bi bi-people"></span>
                            <span class="nav-label">會員管理</span>
                            <span class="bi bi-chevron-down dropdown-icon"></span>
                        </a>

                        <ul class="dropdown-menu">

                            <li class="nav-item @(IsActive("Member", "List") ? "active" : "")">
                                <a asp-controller="Member" asp-action="List"
                                   class="nav-link dropdown-link">
                                    會員列表
                                </a>
                            </li>

                            @* <li class="nav-item @(IsActive("Member", "Create") ? "active" : "")">
                                <a asp-controller="Member" asp-action="Create"
                                   class="nav-link dropdown-link">
                                    新增會員
                                </a>
                            </li>

                            <li class="nav-item @(IsActive("Member", "ImportExport") ? "active" : "")">
                                <a asp-controller="Member" asp-action="ImportExport"
                                   class="nav-link dropdown-link">
                                    匯入 / 匯出
                                </a>
                            </li> *@

                            <li class="nav-item @(IsActive("Member", "ExpireNotice") ? "active" : "")">
                                <a asp-controller="Member" asp-action="ExpireNotice"
                                   class="nav-link dropdown-link">
                                    到期通知
                                </a>
                            </li>

                        </ul>
                    </li>


                    <!-- 組織圖 -->
                    <li class="nav-item @(IsActive("Member", "Organization") ? "active" : "")" @displayItem4Normal>
                        <a asp-controller="Member" asp-action="Organization"
                           class="nav-link">
                            <span class="bi bi-diagram-3"></span>
                            <span class="nav-label">組織圖</span>
                        </a>
                    </li>


                    <!-- 系統公告 -->
                    <li class="nav-item @(IsActive("Notice", "index") ? "active" : "")" @displayItem4Admin>
                        <a asp-controller="Notice" asp-action="index"
                           class="nav-link">
                            <span class="bi bi-megaphone"></span>
                            <span class="nav-label">系統公告</span>
                        </a>
                    </li>


                    <!-- 個人化待辦事項行事曆 -->
                    <li class="nav-item @(IsActive("Calendar", "index") ? "active" : "")">
                        <a asp-controller="Calendar" asp-action="index"
                           class="nav-link">
                            <span class="bi bi-calendar3"></span>
                            <span class="nav-label">個人化待辦事項行事曆</span>
                        </a>
                    </li>

                    <!-- 業績管理 -->
                    @* <li class="nav-item dropdown-container">
                        <a href="#" class="nav-link dropdown-toggle">
                            <span class="bi bi-graph-up-arrow"></span>
                            <span class="nav-label">業績管理</span>
                            <span class="bi bi-chevron-down dropdown-icon"></span>
                        </a>

                        <ul class="dropdown-menu">

                            <li class="nav-item">
                                <a asp-controller="Performance"
                                   asp-action="Dashboard"
                                   class="nav-link dropdown-link">
                                    業績總覽
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Performance"
                                   asp-action="Report"
                                   class="nav-link dropdown-link">
                                    業績報表
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Performance"
                                   asp-action="Ranking"
                                   class="nav-link dropdown-link">
                                    業績排行
                                </a>
                            </li>

                        </ul>
                    </li> *@

                    <!-- 獎金管理 -->
                    @* <li class="nav-item dropdown-container">
                        <a href="#" class="nav-link dropdown-toggle">
                            <span class="bi bi-cash-stack"></span>
                            <span class="nav-label">獎金管理</span>
                            <span class="bi bi-chevron-down dropdown-icon"></span>
                        </a>

                        <ul class="dropdown-menu">

                            <li class="nav-item">
                                <a asp-controller="Bonus"
                                   asp-action="Dashboard"
                                   class="nav-link dropdown-link">
                                    獎金總覽
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Bonus"
                                   asp-action="Report"
                                   class="nav-link dropdown-link">
                                    獎金報表
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Bonus"
                                   asp-action="Setting"
                                   class="nav-link dropdown-link">
                                    獎金設定
                                </a>
                            </li>

                        </ul>
                    </li> *@

                    <!-- 報表中心 -->
                    @* <li class="nav-item dropdown-container">
                        <a href="#" class="nav-link dropdown-toggle">
                            <span class="bi bi-file-earmark-bar-graph"></span>
                            <span class="nav-label">報表中心</span>
                            <span class="bi bi-chevron-down dropdown-icon"></span>
                        </a>

                        <ul class="dropdown-menu">

                            <li class="nav-item">
                                <a asp-controller="Report"
                                   asp-action="Member"
                                   class="nav-link dropdown-link">
                                    會員報表
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Report"
                                   asp-action="Organization"
                                   class="nav-link dropdown-link">
                                    組織報表
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Report"
                                   asp-action="Performance"
                                   class="nav-link dropdown-link">
                                    業績報表
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Report"
                                   asp-action="Bonus"
                                   class="nav-link dropdown-link">
                                    獎金報表
                                </a>
                            </li>

                        </ul>
                    </li> *@
                </ul>

                <ul class="nav-list secondary-nav">
                    @if (SysDefine.SystemConfig)
                    {
                        <!-- 系統設定 -->
                        <li class="nav-item">
                            <a asp-controller="SysConfig"
                            asp-action="Index"
                            class="nav-link">
                                <span class="bi bi-gear"></span>
                                <span class="nav-label">系統設定</span>
                            </a>
                        </li>
                    }

                    <!-- 操作紀錄 -->
                    <li class="nav-item">
                        <a asp-controller="Log"
                           asp-action="Index"
                           class="nav-link">
                            <span class="bi bi-journal-text"></span>
                            <span class="nav-label">操作紀錄</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <footer class="sidebar-footer"
                    data-bs-toggle="tooltip"
                    data-bs-placement="right"
                    title="B2bOrder 後台管理系統 v1.0.0 (Build 2026)">

                <div class="full-copyright">
                    <p>© 2026 <span>B2bOrder</span>.</p>
                    <p>All rights reserved.</p>
                    <p class="version-tag">Version 1.0.0</p>
                </div>

                <div class="short-copyright">
                    <span>1.0.0</span>
                </div>
            </footer>
        </aside>
    }

    <div class="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* 登出確認對話框 *@
    <div class="modal fade" id="confirmLogoutModal" tabindex="-1" aria-labelledby="confirmLogoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center">
                        <img src="~/images/logo.png" alt="Logo" style="width:32px; height:32px; object-fit:cover; border-radius:50%;" class="me-2" />
                        <h5 class="modal-title mb-0" id="confirmLogoutModalLabel">確認登出</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <div class="modal-body">
                    您確定要登出嗎？
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button id="confirmLogoutBtn" type="button" class="btn btn-danger">登出</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // 登出確認：確認按鈕提交隱藏表單
        document.addEventListener('DOMContentLoaded', function () {
            var confirmBtn = document.getElementById('confirmLogoutBtn');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', function () {
                    var form = document.getElementById('logoutForm');
                    if (form) form.submit();
                });
            }

            // 注意：將 dropdown 行為集中在 site.js（避免重複綁定）
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    // 輔助函式：精準判斷是否為目前頁面路徑
    bool IsActive(string c, string a) =>
        ViewContext.RouteData.Values["Controller"]?.ToString() == c &&
        ViewContext.RouteData.Values["Action"]?.ToString() == a;
}