@model B2bOrder.Models.HomeDashboardViewModel

@{
    ViewData["Title"] = "個人待辦行事曆";
}

<link rel="stylesheet" href="~/css/all.min.css" />
<link rel="stylesheet" href="~/css/calendar.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container-fluid p-4 bg-light text-dark text-start" style="min-height: 100vh; font-family: 'Microsoft JhengHei', sans-serif;">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold mb-1">個人待辦行事曆</h4>
            <p class="text-muted mb-0">個人化待辦事項行事曆管理中心。</p>
        </div>
        <div>
            <button class="btn btn-primary px-3 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addTodoModal">
                <i class="fa-solid fa-plus me-1"></i> 新增待辦事項
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-2 col-lg-3">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 8px; background: #ffffff;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold m-0 text-secondary">
                        <i class="fa-solid fa-list-ul me-1"></i> 未排程事項
                    </h6>
                    <span class="badge bg-primary rounded-pill" id="todo-count">0</span>
                </div>

                <div id="external-events" class="d-flex flex-column gap-2" style="max-height: 65vh; overflow-y: auto; padding-right: 4px;">
                </div>
            </div>

            <div class="card border-0 shadow-sm p-3 mt-3 d-flex flex-row justify-content-between align-items-center" style="border-radius: 8px; background: #ffffff;">
                <span class="text-secondary small fw-bold"><i class="fa-solid fa-eye me-1"></i> 顯示已完成事項</span>
                <div class="form-check form-switch m-0 p-0" style="min-height: auto;">
                    <input class="form-check-input m-0" type="checkbox" id="showCompleted" checked style="cursor: pointer; width: 2.5em; height: 1.25em;">
                </div>
            </div>
        </div>

        <div class="col-xl-10 col-lg-9">
            <div class="card border-0 shadow-sm p-2" style="border-radius: 8px; background: #ffffff;">
                <div id="calendar"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addTodoModal" tabindex="-1" aria-labelledby="addTodoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="addTodoModalLabel">✨ 新增待辦事項</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <form id="addTodoForm">
                    <div class="mb-3">
                        <label for="todoTitle" class="form-label small fw-bold text-muted">事項名稱</label>
                        <input type="text" class="form-control" id="todoTitle" placeholder="請輸入待辦事項名稱..." required autocomplete="off" style="border-radius: 6px;">
                    </div>
                    <div class="mb-2">
                        <label for="todoCategory" class="form-label small fw-bold text-muted">分類標籤</label>
                        <select class="form-select" id="todoCategory" style="border-radius: 6px;">
                            <option value="bg-work-event" selected>工作事項</option>
                            <option value="bg-life-event">生活行程</option>
                            <option value="bg-personal-event">個人專案</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light py-2" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary btn-sm px-3" id="btnSaveTodo">確認新增</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editTodoModal" tabindex="-1" aria-labelledby="editTodoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="editTodoModalLabel">✏️ 編輯待辦事項</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <form id="editTodoForm">
                    <input type="hidden" id="editTodoId" />
                    <div class="mb-3">
                        <label for="editTodoTitle" class="form-label small fw-bold text-muted">事項名稱</label>
                        <input type="text" class="form-control" id="editTodoTitle" required autocomplete="off" style="border-radius: 6px;">
                    </div>
                    <div class="mb-2">
                        <label for="editTodoCategory" class="form-label small fw-bold text-muted">分類標籤</label>
                        <select class="form-select" id="editTodoCategory" style="border-radius: 6px;">
                            <option value="bg-work-event">工作事項</option>
                            <option value="bg-life-event">生活行程</option>
                            <option value="bg-personal-event">個人專案</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light py-2 d-flex justify-content-between" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                <div>
                    <button type="button" class="btn btn-outline-danger btn-sm me-1" id="btnModalDeleteTodo">
                        <i class="fa-solid fa-trash-can me-1"></i> 刪除
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm" id="btnModalCompleteTodo">
                        <i class="fa-solid fa-check me-1"></i> 標示為已完成
                    </button>
                </div>
                <div>
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-primary btn-sm px-3" id="btnUpdateTodo">儲存變更</button>
                </div>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
    <script src="~/js/calendar.js"></script>
}