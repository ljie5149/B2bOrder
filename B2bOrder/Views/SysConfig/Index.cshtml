<form id="bulkActionForm" asp-action="BulkAction" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="actionType" id="bulkActionType" />
</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 自動追蹤上次進入或重新整理後的 Tab 頁籤狀態
            var triggerEl = document.querySelector('#settingsTab button[id="@activeTab-tab"]');
            if (triggerEl) {
                var tab = new bootstrap.Tab(triggerEl);
                tab.show();
            }

            // 非同步即時更新：點選個別開關時不用點大儲存也能即時透過 Ajax 寫入資料庫
            const switches = document.querySelectorAll('.module-switch');
            switches.forEach(sw => {
                sw.addEventListener('change', function () {
                    const moduleCode = this.getAttribute('data-code');
                    const isAvailable = this.checked;

                    fetch('/SysConfig/ToggleModuleStatus', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            ModuleCode: moduleCode,
                            IsAvailable: isAvailable
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            console.log(data.message);
                            // 這裡可以選擇性加入即時變更 Badge 的文字與顏色邏輯
                            window.location.reload(); // 重新載入以渲染最新狀態與看板
                        } else {
                            alert('非同步同步失敗：' + data.message);
                            this.checked = !isAvailable; // 復原開關
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        this.checked = !isAvailable;
                    });
                });
            });
        });

        // 提交快速操作的 JavaScript 函數
        function submitBulkAction(type) {
            document.getElementById('bulkActionType').value = type;
            document.getElementById('bulkActionForm').submit();
        }
    </script>
}